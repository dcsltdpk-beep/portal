# Railway Postgres (public TCP proxy URL), one login per role
DATABASE_URL_RO=postgresql://portal_ro:CHANGE_ME_RO@HOST.proxy.rlwy.net:PORT/railway
DATABASE_URL_RW=postgresql://portal_rw:CHANGE_ME_RW@HOST.proxy.rlwy.net:PORT/railway

# n8n webhooks (Header Auth credential: name X-DCS-Key)
N8N_BASE_URL=https://n8n.yourdomain.com/webhook
N8N_API_KEY=same-long-random-string-as-n8n-header-auth

# Session signing secret: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string
